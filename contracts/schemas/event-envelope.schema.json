{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-envelope.schema.json",
  "title": "Envelope de evento no stream rec:events (campo `payload`)",
  "description": "Produzido pela API Rust, consumido pelo worker Python.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "event_id", "type", "occurred_at", "received_at"],
  "properties": {
    "v": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "type": {"enum": ["content_viewed", "content_liked", "content_saved", "content_shared",
                      "content_commented", "feed_impression", "content_published", "content_removed"]},
    "user_id": {"type": ["integer", "null"], "minimum": 1},
    "content_id": {"type": ["integer", "null"], "minimum": 1},
    "content_ids": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 1}, "maxItems": 100},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": ["string", "null"], "maxLength": 64}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"enum": ["content_viewed", "content_liked", "content_saved", "content_shared", "content_commented"]}}},
      "then": {"required": ["user_id", "content_id"], "properties": {"user_id": {"type": "integer"}, "content_id": {"type": "integer"}}}
    },
    {
      "if": {"properties": {"type": {"const": "feed_impression"}}},
      "then": {"required": ["user_id", "content_ids"], "properties": {"user_id": {"type": "integer"}, "content_ids": {"type": "array", "minItems": 1}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["content_published", "content_removed"]}}},
      "then": {"required": ["content_id"], "properties": {"content_id": {"type": "integer"}}}
    }
  ]
}
