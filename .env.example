# Copie para .env e TROQUE todos os segredos. Valores abaixo são apenas demonstrativos.
#   cp .env.example .env
# Gere segredos com: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# --- PostgreSQL
POSTGRES_DB=reco
POSTGRES_USER=reco_owner
POSTGRES_PASSWORD=troque-owner-demo
# Role de aplicação (privilégio mínimo; criada em deploy/postgres/init)
APP_DB_PASSWORD=troque-app-demo

# --- Redis
REDIS_PASSWORD=troque-redis-demo
REDIS_MAXMEMORY=512mb

# --- Autenticação
# hmac (padrão) ou disabled (somente desenvolvimento local!)
AUTH_MODE=hmac
# >= 32 caracteres. Também usado por scripts/make_token.py e pelo k6.
AUTH_SECRET=troque-este-segredo-de-demonstracao-0123456789
# Token compartilhado entre a API Rust e o motor Python (rede interna)
INTERNAL_TOKEN=troque-token-interno-demo
CORS_ALLOWED_ORIGINS=

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque-grafana-demo

# --- Portas publicadas em 127.0.0.1
API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Ajustes de desempenho (opcionais)
HTTP_WORKERS=2
ENGINE_WORKERS=2
ENGINE_TIMEOUT_MS=800
ENGINE_MAX_CONCURRENCY=4
FEED_SIZE=300
FEED_TTL_SECONDS=3600
FEED_SOFT_TTL_SECONDS=600
REBUILD_DEDUP_SECONDS=120

# --- Pesos do ranking (JSON parcial; chaves omitidas mantêm o padrão). Ver docs/ALGORITHM.md
# RANKING_WEIGHTS={"interest":0.4,"recency":0.1}
RANKING_WEIGHTS=

# --- Volume do seed
SEED_USERS=2000
SEED_AUTHORS=300
SEED_CONTENTS=20000
